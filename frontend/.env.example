# Base URL of the CampusFlow backend API (no trailing slash).
#
# Local (default): the Docker Compose / dotnet run backend on localhost:5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
#
# Production (Vercel): set this in the Vercel project's Environment Variables to your deployed
# Render backend URL, e.g. https://campusflow-backend.onrender.com — no code change needed.
# Note: NEXT_PUBLIC_* variables are baked in at build time, so set it BEFORE deploying/building.
