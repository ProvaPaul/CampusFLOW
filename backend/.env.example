# These map to ASP.NET Core configuration using the "__" (double underscore) convention.
# For local `dotnet run`, the defaults in appsettings.json already work out of the box —
# this file only matters if you want to override them (e.g. via Docker or user secrets).

MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=campusflow

# Use a long, random, secret value in any real deployment.
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=CampusFlow.Api
Jwt__Audience=CampusFlow.Client
Jwt__ExpiryMinutes=120

Cors__AllowedOrigins__0=http://localhost:3000

# Optional — powers the AI Assignment Generator and AI Feedback Assistant (Google Gemini).
# Leave empty/unset to run without them: the frontend detects this via GET /api/ai/status
# and hides the AI actions instead of erroring. Get a free key at https://aistudio.google.com/apikey
Ai__ApiKey=
Ai__Model=gemini-2.5-flash
